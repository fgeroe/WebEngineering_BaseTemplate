{
  "name": "webengineering_basetemplate",
  "version": "1.0.0",
  "private": true,
  "description": "This repository is designed as the foundation for coding playgrounds in the Web Engineering course. It offers a structured space for experimenting with and mastering various web development technologies and practices.  The project is based on [this](https://developer.mozilla.org/en-US/docs/Learn/Accessibility/Accessibility_troubleshooting) repository from MDN.",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently --names web,api --prefix-colors blue,green \"wait-on --timeout 30000 http-get://127.0.0.1:3000/health && npm run dev -w apps/web\" \"npm run dev -w apps/api\"",
    "preview:cross-origin": "npm run preview:cross-origin -w apps/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint apps --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "lint:fix": "eslint apps --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"apps/*/src/**/*.{js,jsx,ts,tsx}\" \"apps/*/*.ts\"",
    "format:check": "prettier --check \"apps/*/src/**/*.{js,jsx,ts,tsx}\" \"apps/*/*.ts\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fgeroe/WebEngineering_BaseTemplate.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/fgeroe/WebEngineering_BaseTemplate/issues"
  },
  "homepage": "https://github.com/fgeroe/WebEngineering_BaseTemplate#readme",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "5.9",
    "wait-on": "^9.5.1"
  },
  "lint-staged": {
    "apps/*/{src/**/*,*}.{js,jsx,ts,tsx}": [
      "eslint --max-warnings 0",
      "prettier --check"
    ]
  }
}
