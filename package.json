{
  "name": "webengineering_basetemplate",
  "version": "1.0.0",
  "private": true,
  "description": "This repository is designed as the foundation for coding playgrounds in the Web Engineering course. It offers a structured space for experimenting with and mastering various web development technologies and practices.  The project is based on [this](https://developer.mozilla.org/en-US/docs/Learn/Accessibility/Accessibility_troubleshooting) repository from MDN.",
  "scripts": {
  "dev": "vite",
  "build": "tsc && vite build",
  "preview": "vite preview",
  "typecheck": "tsc",
  "lint": "eslint src --ext .js,.jsx,.ts,.tsx --max-warnings 0",
  "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
  "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
  "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
  "prepare": "husky"
},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fgeroe/WebEngineering_BaseTemplate.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/fgeroe/WebEngineering_BaseTemplate/issues"
  },
  "homepage": "https://github.com/fgeroe/WebEngineering_BaseTemplate#readme",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "5.9",
    "vite": "^8.3.1"
  },
  "lint-staged": {
  "src/**/*.{js,jsx,ts,tsx}": [
    "eslint --max-warnings 0",
    "prettier --check"
  ]
},
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
